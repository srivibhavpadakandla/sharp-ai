---
import Base from '../layouts/Base.astro';
import AskIsland from '../components/AskIsland.tsx';
export const prerender = true;
---
<Base
  title="Asking… — Sharp AI"
  description="Sharp AI is retrieving the FTC documentation sections that answer your question."
  noindex
  bare
>
  <!-- client:only means nothing renders on the server, so the document shipped
       with no heading at all. This one is always present and is what the
       question replaces visually. -->
  <h1 class="sr-only">Ask about your FTC robot</h1>
  <AskIsland client:only="react" />
</Base>
