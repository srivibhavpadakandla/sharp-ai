---
import Base from '../layouts/Base.astro';
---
<Base title="Offline — Sharp AI" description="You are offline." noindex>
  <section class="wrap prose-page">
    <p class="eyebrow">Offline</p>
    <h1>No connection.</h1>
    <p class="lede">
      Sharp AI reads the documentation and writes an answer on the server, so it
      needs a connection to answer anything. Pages you have already opened will
      still load.
    </p>
    <p>
      The <a href="/path">path planner</a> and the <a href="/cad">CAD viewer</a>
      both run entirely in this browser, so they work offline once the page has
      loaded — useful in a pit with bad wifi.
    </p>
  </section>
</Base>
