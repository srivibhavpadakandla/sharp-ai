---
import '../styles/global.css';
import { SITE_URL, SITE_NAME, SDK_VERSION, CORPUS_SECTIONS, CORPUS_UPDATED } from '../lib/config';
import HeaderSearch from '../components/HeaderSearch.tsx';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Chat surfaces own the full viewport and carry their own footer copy. */
  bare?: boolean;
}
const { title, description, canonical, noindex = false, jsonLd, bare = false } = Astro.props;
const url = canonical || new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
---
<!doctype html>
<html lang="en">
<head>
  <script is:inline>
    /* Runs before first paint: a theme applied from a module or an island
       shows one frame of the wrong colours, which is worse than no toggle. */
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) { document.documentElement.dataset.theme = 'dark'; }
    })();
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:image" content={new URL('/og.png', Astro.site ?? SITE_URL).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sharp AI — search every FTC doc at once" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Versioned: browsers cache a favicon far more stubbornly than a page, and
       held on to the previous mark through two deploys without the query. -->
  <link rel="icon" href="/logo.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png?v=3" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />

  <!-- Installable. iOS ignores the manifest's theme_color and display mode, so
       it needs its own tags; without them the icon opens Safari with its chrome
       and it reads as a bookmark rather than an app. -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Sharp AI" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#0b0e12" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a href="/" class="wordmark">
        <img src="/logo.svg?v=3" alt="" width="26" height="26" class="wordmark__mark" />
        Sharp<em>AI</em>
      </a>
      <HeaderSearch client:idle />
      <div class="site-head__end">
      <nav id="site-nav">
        <a href="/chat">Chat</a>
        <a href="/season">Season</a>
        <a href="/path">Path planner</a>
        <a href="/cad">CAD</a>
        <a href="/error">Paste an error</a>
        <a href="/about">About</a>
      </nav>
      <div class="site-head__tools">
        <button id="theme-toggle" type="button" class="themeswitch"
          aria-label="Switch between light and dark" title="Light / dark">
          <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" class="themeswitch__sun">
            <circle cx="8" cy="8" r="3.1" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 .9v2.0M8 13.1v2.0M.9 8h2.0M13.1 8h2.0M3 3l1.4 1.4M11.6 11.6L13 13M13 3l-1.4 1.4M4.4 11.6L3 13"
              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" class="themeswitch__moon">
            <path d="M13.4 9.6A5.8 5.8 0 0 1 6.4 2.6 5.9 5.9 0 1 0 13.4 9.6Z"
              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          </svg>
        </button>
        <button id="nav-toggle" type="button" class="navtoggle"
          aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1"><slot /></main>

  {!bare && <footer class="site-foot">
    <div class="wrap">
      <div class="cols">
        <div>
          <p style="margin-bottom:0.6em">
            Sharp AI answers from indexed FIRST Tech Challenge documentation:
            <a href="https://gm0.org" rel="noopener">Game Manual 0</a>, used under
            <a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="license noopener">CC BY-NC 4.0</a>,
            and the official
            <a href="https://ftc-docs.firstinspires.org" rel="noopener">FTC Docs</a>,
            used under BSD 3-Clause.
          </p>
          <p style="margin:0;color:var(--ink-3)">
            Because Game Manual 0 is licensed non-commercially, this site carries
            no advertising, no paid tier and no sponsorship. It never will.
          </p>
        </div>
        <div>
          <p class="eyebrow" style="margin-bottom:0.7em">Indexed sources</p>
          <p style="margin:0 0 0.8em">
            <strong style="font-weight:500">Read in full</strong><br />
            <a href="https://gm0.org" rel="noopener">Game Manual 0</a> · CC BY-NC 4.0<br />
            <a href="https://ftc-docs.firstinspires.org" rel="noopener">FTC Docs</a> · BSD 3-Clause
          </p>
          <p style="margin:0">
            <strong style="font-weight:500">Indexed by link only</strong><br />
            <span style="color:var(--ink-3)">
              REV, Road Runner, CTRL ALT FTC, FTCLib — no open licence published,
              so their text is never copied here.
            </span><br />
            <span style="color:var(--ink-3)">FTC SDK {SDK_VERSION} — API reference and sample OpModes</span>
          </p>
          <p style="margin:0.8em 0 0;color:var(--ink-3)">
            {CORPUS_SECTIONS.toLocaleString()} sections · last indexed {CORPUS_UPDATED}
          </p>
        </div>
      </div>
      <p class="madeby">
        Built by <strong>Sharp Face Robotics</strong>.
      </p>
      <p class="disclaimer">
        Sharp AI is an unofficial, independent project. It is not affiliated with
        or endorsed by <em>FIRST</em>. Answers are generated by a language model
        from retrieved documentation and <strong>can be wrong</strong> — always
        verify against the linked source, and against the official Game Manual
        for anything rules-related before you act on it.
      </p>
    </div>
  </footer>}
  <script is:inline>
    /* Registered after load so it never competes with the first paint. */
    if ('serviceWorker' in navigator) {
      addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () {});
      });
    }
  </script>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var btn = document.getElementById('nav-toggle');
      var nav = document.getElementById('site-nav');
      if (!btn || !nav) return;
      /* Everything the drawer covers. Marked inert while it is open so that
         tabbing cannot walk out of the menu into the page behind it — which it
         did: four presses of Tab landed on the hero buttons with the drawer
         still over them. inert also hides that content from assistive tech,
         which a visual overlay alone does not. */
      var behind = function () {
        return [document.getElementById('main'), document.querySelector('footer'),
                document.querySelector('.hsearch'), document.querySelector('.wordmark'),
                /* The skip link too: it targets #main, which is inert while the
                   drawer is open, so following it would send focus nowhere. */
                document.querySelector('.skip')]
          .filter(Boolean);
      };
      var set = function (open) {
        root.dataset.nav = open ? 'open' : 'closed';
        btn.setAttribute('aria-expanded', String(open));
        /* Hold the page still behind the drawer; a menu that scrolls the page
           underneath it is the classic mobile-nav bug. */
        document.body.style.overflow = open ? 'hidden' : '';
        behind().forEach(function (el) {
          if (open) el.setAttribute('inert', ''); else el.removeAttribute('inert');
        });
        if (open) { var first = nav.querySelector('a'); if (first) first.focus(); }
        else if (document.activeElement === document.body) { btn.focus(); }
      };
      set(false);
      btn.addEventListener('click', function () { set(root.dataset.nav !== 'open'); });
      nav.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
      addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { set(false); btn.focus(); return; }
        if (e.key !== 'Tab' || root.dataset.nav !== 'open') return;
        /* Wrap Tab inside the drawer and the bar. inert on the content behind
           marks it correctly for assistive tech but Chromium still let Tab
           reach the skip link, and following that lands focus in an inert
           #main — nowhere. This is deterministic. */
        var stops = [].slice.call(nav.querySelectorAll('a')).concat([
          document.getElementById('theme-toggle'), btn]).filter(Boolean);
        if (!stops.length) return;
        var i = stops.indexOf(document.activeElement);
        var next = e.shiftKey
          ? (i <= 0 ? stops.length - 1 : i - 1)
          : (i === -1 || i === stops.length - 1 ? 0 : i + 1);
        e.preventDefault();
        stops[next].focus();
      });
      /* Rotating to landscape can cross the breakpoint with the drawer open,
         which would leave the body locked and the desktop nav already showing. */
      addEventListener('resize', function () { if (innerWidth > 736) set(false); });
    })();
    document.getElementById('theme-toggle')?.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      /* The CAD viewer draws with WebGL and cannot read a CSS variable, so it
         is told rather than left looking like the one dark hole in a light page. */
      window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
    });
  </script>
</body>
</html>
