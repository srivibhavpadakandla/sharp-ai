---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.tsx';
import ScatterField from '../components/ScatterField.tsx';
import { CATEGORIES, SEED_QUESTIONS, API_BASE, SITE_TAGLINE } from '../lib/config';

// Popular questions come from the answers table when the site has traffic;
// until then the seeded list keeps the index dense and browsable.
type Q = { slug: string; question: string; category: string };
let live: Record<string, Q[]> = {};
try {
  const res = await fetch(`${API_BASE}/api/categories`, { signal: AbortSignal.timeout(4000) });
  if (res.ok) {
    const data = await res.json() as { categories: Array<{ id: string; questions: Q[] }> };
    live = Object.fromEntries(data.categories.map((c) => [c.id, c.questions || []]));
  }
} catch { /* build offline: fall back to seeds */ }

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sharp AI',
  description: SITE_TAGLINE,
  url: 'https://sharp-ai-8a1.pages.dev',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://sharp-ai-8a1.pages.dev/ask?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---
<Base
  title="Sharp AI — FTC documentation, answered"
  description="Ask a question about building, wiring or programming a FIRST Tech Challenge robot and get an answer drawn from indexed official documentation, with the source section shown next to it."
  jsonLd={jsonLd}
>
  <section class="hero">
    <ScatterField client:idle />
    <div class="wrap">
      <p class="hero__mark rise d1">Sharp AI</p>
      <h1 class="hero__title">
        Search every FTC doc<br /><em>at once.</em>
      </h1>
      <p class="hero__lede rise d3">
        Game Manual 0, the official FTC Docs, the SDK reference, Pedro Pathing,
        REV and Chief Delphi. Around 3,500 sections, so you can ask a question
        instead of opening ten tabs.
      </p>
      <div class="hero__actions rise d4">
        <a class="btn btn--primary" href="/chat">Ask a question</a>
        <a class="btn" href="/browse">Browse the index</a>
      </div>
    </div>
  </section>

  <!-- The film plays at full size, then collapses into the chat bar as you keep
       scrolling. Tall section, sticky stage: the scroll distance is what drives
       the morph. -->
  <section class="film" data-film-stage>
    <div class="film__rail">
    <div class="wrap">
      <figure class="film__box" data-morph>
        <video
          class="film__v"
          poster="/planner-film-poster.png"
          muted playsinline loop preload="none"
          aria-label="A route being drawn on the field while the Pedro Pathing code writes itself"
        >
          <source src="/planner-film.mp4" type="video/mp4" />
          <source src="/planner-film.webm" type="video/webm" />
        </video>
        <button type="button" class="film__toggle" data-film-toggle aria-label="Play the film">Play</button>

        <a class="film__bar" data-morph-bar href="/chat" aria-label="Open the chat">
          <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <span data-morph-ph>Ask it anything about FTC</span>
          <span class="film__send" data-morph-send>
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M7 11.5V2.5M3 6.5 7 2.5l4 4" fill="none" stroke="currentColor"
                stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </figure>
      <p class="film__cue" data-morph-cue>Keep scrolling</p>
      <p class="film__prompt" data-morph-prompt>Now ask it something.</p>
    </div>
    </div>
  </section>

  <!-- Statement, then a panel that shows the thing rather than describing it.
       The cosmos home page alternates these; the captions on the three cards
       below read as one sentence across the row. -->
  <section class="say">
    <div class="wrap">
      <h2>Every answer points at a page.</h2>
    </div>
  </section>

  <section class="trio">
    <div class="wrap">
      <div class="trio__grid">
        <article class="trio__card">
          <div class="trio__art trio__art--a">
            <img src="/art/cat-rules.webp" alt="" loading="lazy" width="320" height="240" />
          </div>
          <p>From the actual docs,</p>
        </article>
        <article class="trio__card">
          <div class="trio__art trio__art--b">
            <img src="/art/cat-programming.webp" alt="" loading="lazy" width="320" height="240" />
          </div>
          <p>with the section it came from,</p>
        </article>
        <article class="trio__card">
          <div class="trio__art trio__art--c">
            <span class="trio__refusal">Nothing in the index covers that.</span>
          </div>
          <p>or it tells you it doesn't know.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="say">
    <div class="wrap">
      <h2>Draw a path. Take the Java.</h2>
    </div>
  </section>

  <section class="panel reveal">
    <div class="wrap">
      <a class="panel__box" href="/path">
        <svg class="panel__field" viewBox="0 0 144 144" role="img" aria-label="A Pedro Pathing route drawn across the field">
          <rect x="0" y="0" width="144" height="144" rx="3" class="pf-bg" />
          <g class="pf-grid">
            <line x1="24" y1="0" x2="24" y2="144" /><line x1="48" y1="0" x2="48" y2="144" />
            <line x1="72" y1="0" x2="72" y2="144" /><line x1="96" y1="0" x2="96" y2="144" />
            <line x1="120" y1="0" x2="120" y2="144" />
            <line x1="0" y1="24" x2="144" y2="24" /><line x1="0" y1="48" x2="144" y2="48" />
            <line x1="0" y1="72" x2="144" y2="72" /><line x1="0" y1="96" x2="144" y2="96" />
            <line x1="0" y1="120" x2="144" y2="120" />
          </g>
          <path class="pf-path" d="M 22 84 L 60 58 Q 86 46 112 82" />
          <rect class="pf-bot" x="-8" y="-8" width="16" height="16" rx="2" />
          <circle class="pf-pt" cx="22" cy="84" r="3.2" />
          <circle class="pf-pt" cx="60" cy="58" r="3.2" />
          <circle class="pf-pt" cx="112" cy="82" r="3.2" />
        </svg>
        <div class="panel__copy">
          <h3>Path planner</h3>
          <p>
            Drag waypoints on a 144&quot; field, watch the robot run the route, and copy
            out a PathChain that uses the real BezierLine, BezierCurve and heading
            interpolation calls. It flags the degenerate control points Pedro's own
            docs warn about.
          </p>
          <span class="panel__go">Open the planner</span>
        </div>
      </a>
    </div>
  </section>

  <hr class="rule" />

  <section id="browse" class="browse">
    <div class="wrap">
      <div class="browse__head">
        <h2>Browse by system</h2>
        <p>Questions people have already asked, grouped by the part of the robot they are about.</p>
      </div>

      <div class="grid">
        {CATEGORIES.map((cat) => {
          const answered = live[cat.id] || [];
          const seeds = SEED_QUESTIONS[cat.id] || [];
          return (
            <article class="cell">
              <header class="cell__head">
                <h3>{cat.label}</h3>
                <span class="cell__n">{answered.length || seeds.length}</span>
              </header>
              <p class="cell__blurb">{cat.blurb}</p>
              <ul class="cell__list">
                {answered.slice(0, 5).map((q) => (
                  <li><a href={`/q/${q.slug}`}>{q.question}</a></li>
                ))}
                {answered.length === 0 && seeds.slice(0, 5).map((q) => (
                  <li><a href={`/ask?q=${encodeURIComponent(q)}`}>{q}</a></li>
                ))}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="how">
    <div class="wrap">
      <div class="how__grid">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 class="how__title">What happens when you ask</h2>
        </div>
        <ol class="how__steps">
          <li>
            Your question runs through a keyword search and a semantic search at
            the same time, and the two lists of results get merged.
          </li>
          <li>
            If nothing in the docs really matches, you get told that. The check
            runs on the search scores, before any model is called.
          </li>
          <li>
            The model only ever sees the sections that came back. It has to say
            where each claim came from, and it is told not to invent part
            numbers, gear ratios or rule numbers.
          </li>
          <li>
            Answers keep a permanent link, with the sections they used sitting
            next to them.
          </li>
        </ol>
      </div>
    </div>
  </section>
</Base>

<script>
  // The film collapsing into the chat bar, scrubbed by scroll position rather
  // than played on a timer, so the user drives it.
  //
  // One scroll-linked value feeds an explicit paint(), instead of several
  // timeline tracks at hand-placed offsets: with tracks the morph finished in
  // the first third of the section and the remaining 150vh scrolled past a
  // frozen bar.
  import { animate, onScroll, eases, utils } from 'animejs';

  const stage = document.querySelector('[data-film-stage]');
  const box = document.querySelector('[data-morph]');
  const bar = document.querySelector('[data-morph-bar]');
  const send = document.querySelector('[data-morph-send]');
  const cue = document.querySelector('[data-morph-cue]');
  const prompt = document.querySelector('[data-morph-prompt]');
  const video = document.querySelector('.film__v');
  const toggle = document.querySelector('[data-film-toggle]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && box && bar && !reduced) {
    let full = { w: 0, h: 0 };
    let target = { w: 0, h: 60 };

    /** Progress within [a,b], 0 outside it. */
    const span = (p, a, b) => Math.max(0, Math.min(1, (p - a) / (b - a)));
    const mix = (from, to, t) => from + (to - from) * t;

    const paint = (p) => {
      const morph = eases.inOut(2)(span(p, 0.30, 0.78));
      box.classList.toggle('is-morphing', p > 0.30);
      box.classList.toggle('is-bar', p > 0.95);

      box.style.width = mix(full.w, target.w, morph) + 'px';
      box.style.height = mix(full.h, target.h, morph) + 'px';
      box.style.borderRadius = mix(32, 999, morph) + 'px';

      const fade = span(p, 0.60, 0.78);
      if (video) {
        video.style.opacity = String(1 - fade);
        if (fade > 0.5 && !video.paused) video.pause();
      }
      if (toggle) toggle.style.opacity = String(1 - span(p, 0.30, 0.45));
      if (cue) {
        cue.style.opacity = String(1 - span(p, 0.20, 0.34));
        cue.style.transform = `translateY(${-8 * span(p, 0.20, 0.34)}px)`;
      }
      bar.style.opacity = String(eases.out(2)(span(p, 0.70, 0.86)));
      if (prompt) {
        const pr = eases.out(2)(span(p, 0.76, 0.94));
        prompt.style.opacity = String(pr);
        prompt.style.transform = `translateY(${(1 - pr) * 14}px)`;
      }
      if (send) {
        const s = eases.outBack(1.7)(span(p, 0.78, 0.96));
        send.style.transform = `scale(${mix(0.3, 1, s)})`;
      }
    };

    const measure = () => {
      // Clear the animated values first, or a resize measures whatever the last
      // frame left behind instead of the real resting layout.
      box.style.width = '';
      box.style.height = '';
      box.style.borderRadius = '';
      box.classList.remove('is-morphing', 'is-bar');
      const r = box.getBoundingClientRect();
      full = { w: r.width, h: r.height };
      target = { w: Math.min(560, window.innerWidth * 0.86), h: 60 };
    };

    const state = { p: 0 };
    measure();

    animate(state, {
      p: 1,
      duration: 1000,
      ease: 'linear',
      autoplay: onScroll({
        target: stage,
        enter: 'top top',
        leave: 'bottom bottom',
        sync: 0.4,
      }),
      onUpdate: () => paint(state.p),
    });

    // Width only: a mobile URL bar collapsing changes height on every scroll,
    // and re-measuring mid-morph would read the animated size as the resting one.
    let lastW = window.innerWidth;
    addEventListener('resize', () => {
      if (window.innerWidth === lastW) return;
      lastW = window.innerWidth;
      const p = state.p;
      measure();
      paint(p);
    });
  }
</script>

<script>
  // The little field on the planner card runs its own route: the line draws
  // itself, then the robot drives it, turning to follow the curve.
  import { animate, createTimeline, createDrawable, createMotionPath, stagger, utils } from 'animejs';

  const card = document.querySelector('.panel__field');
  if (card && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let tl = null;

    const start = () => {
      if (tl) return;
      // Park it on the start of the route and keep it hidden. Left at its
      // untransformed origin it flashed as a green square in the top-left
      // corner during the gap between fading in and the motion starting.
      utils.set('.pf-bot', { translateX: 22, translateY: 84, opacity: 0 });

      tl = createTimeline({ loop: true, defaults: { ease: 'inOut(2)' } });
      tl
        .add(createDrawable('.pf-path'), { draw: ['0 0', '0 1'], duration: 1100, ease: 'out(2)' }, 0)
        .add('.pf-pt', { scale: [0, 1], delay: stagger(120), duration: 420, ease: 'out(3)' }, 200)
        .add('.pf-bot', { opacity: [0, 1], duration: 240 }, 1000)
        .add('.pf-bot', {
          ...createMotionPath('.pf-path'),
          duration: 2600,
          ease: 'inOut(2)',
        }, 1000)
        // Hold at the far end, then fade out so the loop restarts cleanly
        // instead of snapping the robot back to the start.
        .add('.pf-bot', { opacity: [1, 0], duration: 400 }, 4000)
        .add(createDrawable('.pf-path'), { draw: ['1 1'], duration: 500, ease: 'in(2)' }, 4100);
    };

    // Only while the card is on screen — this loops forever otherwise.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { start(); tl?.play(); }
        else tl?.pause();
      }
    }, { threshold: 0.2 });
    io.observe(card);
  }
</script>

<script>
  // Entrances. Words for the headlines, a stagger for the card rows.
  import { animate, stagger, split, utils } from 'animejs';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    /** Split a heading into words and lift them in. */
    const words = (el, opts = {}) => {
      // accessible keeps the original text for screen readers; without it a
      // split headline reads as a pile of loose spans.
      const s = split(el, { words: true, chars: false, accessible: true });
      return animate(s.words, {
        opacity: [0, 1],
        y: [26, 0],
        filter: ['blur(7px)', 'blur(0px)'],
        delay: stagger(52),
        duration: 850,
        ease: 'out(3)',
        ...opts,
      });
    };

    const title = document.querySelector('.hero__title');
    if (title) {
      words(title, {
        // The scattered plates position themselves against the measured copy,
        // so they have to re-measure once the words have settled — mid-flight
        // they read the animated positions, not the resting ones.
        onComplete: () => dispatchEvent(new Event('resize')),
      });
    }

    // Split and hide up front. Left visible, a card would be on screen at full
    // opacity and then blink out the moment its observer fired.
    const splits = new Map();
    document.querySelectorAll('.say h2').forEach((h) => {
      const s = split(h, { words: true, chars: false, accessible: true });
      utils.set(s.words, { opacity: 0 });
      splits.set(h, s);
    });
    utils.set(document.querySelectorAll('.trio__card'), { opacity: 0 });

    // Statement headlines and card rows, once each as they come into view.
    const seen = new WeakSet();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting || seen.has(e.target)) continue;
        seen.add(e.target);
        io.unobserve(e.target);

        if (e.target.matches('.say h2')) {
          const sp = splits.get(e.target);
          if (sp) {
            animate(sp.words, {
              opacity: [0, 1], y: [26, 0], filter: ['blur(7px)', 'blur(0px)'],
              delay: stagger(52), duration: 850, ease: 'out(3)',
            });
          }
          continue;
        }

        const cards = e.target.querySelectorAll('.trio__card');
        if (cards.length) {
          animate(cards, {
            opacity: [0, 1],
            y: [34, 0],
            scale: [0.965, 1],
            delay: stagger(110),
            duration: 900,
            ease: 'out(3)',
          });
        }
      }
    }, { threshold: 0.25, rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('.say h2, .trio').forEach((el) => io.observe(el));
  }
</script>

<script>
  // Reveal on scroll. Everything starts visible in the markup and is only
  // hidden once this runs, so a failed script or a no-JS reader still gets the
  // whole page rather than a blank one.
  const items = document.querySelectorAll('.reveal');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced && 'IntersectionObserver' in window) {
    items.forEach((el) => el.classList.add('reveal--armed'));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('reveal--in');
        io.unobserve(e.target);
      }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
    items.forEach((el) => io.observe(el));
  }

  // The film only plays while it is on screen: a looping video running behind
  // three screens of scroll is wasted battery on a laptop in the pits.
  const film = document.querySelector('[data-film-toggle]');
  const video = document.querySelector('.film__v');
  if (film && video) {
    let wanted = !reduced;
    const sync = () => {
      const visible = video.getBoundingClientRect().top < innerHeight && video.getBoundingClientRect().bottom > 0;
      if (wanted && visible) video.play().catch(() => {});
      else video.pause();
      film.textContent = wanted ? 'Pause' : 'Play';
      film.setAttribute('aria-label', wanted ? 'Pause the film' : 'Play the film');
    };
    film.addEventListener('click', () => { wanted = !wanted; sync(); });
    addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
