---
import '../styles/global.css';
import { SITE_URL, SITE_NAME, SDK_VERSION, CORPUS_SECTIONS, CORPUS_UPDATED } from '../lib/config';
import HeaderSearch from '../components/HeaderSearch.tsx';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Chat surfaces own the full viewport and carry their own footer copy. */
  bare?: boolean;
}
const { title, description, canonical, noindex = false, jsonLd, bare = false } = Astro.props;
const url = canonical || new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:image" content={new URL('/og.png', Astro.site ?? SITE_URL).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sharp AI — search every FTC doc at once" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Versioned: browsers cache a favicon far more stubbornly than a page, and
       held on to the previous mark through two deploys without the query. -->
  <link rel="icon" href="/logo.svg?v=3" type="image/svg+xml" />
  <link rel="icon" href="/favicon.png?v=3" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a href="/" class="wordmark">
        <img src="/logo.svg?v=3" alt="" width="26" height="26" class="wordmark__mark" />
        Sharp<em>AI</em>
      </a>
      <HeaderSearch client:idle />
      <nav>
        <a href="/chat">Chat</a>
        <a href="/browse">Browse</a>
        <a href="/path">Path planner</a>
        <a href="/cad">CAD</a>
        <a href="/error">Paste an error</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>

  <main id="main" tabindex="-1"><slot /></main>

  {!bare && <footer class="site-foot">
    <div class="wrap">
      <div class="cols">
        <div>
          <p style="margin-bottom:0.6em">
            Sharp AI answers from indexed FIRST Tech Challenge documentation:
            <a href="https://gm0.org" rel="noopener">Game Manual 0</a>, used under
            <a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="license noopener">CC BY-NC 4.0</a>,
            and the official
            <a href="https://ftc-docs.firstinspires.org" rel="noopener">FTC Docs</a>,
            used under BSD 3-Clause.
          </p>
          <p style="margin:0;color:var(--ink-3)">
            Because Game Manual 0 is licensed non-commercially, this site carries
            no advertising, no paid tier and no sponsorship. It never will.
          </p>
        </div>
        <div>
          <p class="eyebrow" style="margin-bottom:0.7em">Indexed sources</p>
          <p style="margin:0 0 0.8em">
            <strong style="font-weight:500">Read in full</strong><br />
            <a href="https://gm0.org" rel="noopener">Game Manual 0</a> · CC BY-NC 4.0<br />
            <a href="https://ftc-docs.firstinspires.org" rel="noopener">FTC Docs</a> · BSD 3-Clause
          </p>
          <p style="margin:0">
            <strong style="font-weight:500">Indexed by link only</strong><br />
            <span style="color:var(--ink-3)">
              REV, Road Runner, CTRL ALT FTC, FTCLib — no open licence published,
              so their text is never copied here.
            </span><br />
            <span style="color:var(--ink-3)">FTC SDK {SDK_VERSION} — API reference and sample OpModes</span>
          </p>
          <p style="margin:0.8em 0 0;color:var(--ink-3)">
            {CORPUS_SECTIONS.toLocaleString()} sections · last indexed {CORPUS_UPDATED}
          </p>
        </div>
      </div>
      <p class="madeby">
        Built by <strong>Sharp Face Robotics</strong>.
      </p>
      <p class="disclaimer">
        Sharp AI is an unofficial, independent project. It is not affiliated with
        or endorsed by <em>FIRST</em>. Answers are generated by a language model
        from retrieved documentation and <strong>can be wrong</strong> — always
        verify against the linked source, and against the official Game Manual
        for anything rules-related before you act on it.
      </p>
    </div>
  </footer>}
</body>
</html>
