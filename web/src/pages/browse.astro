---
import Base from '../layouts/Base.astro';
import { CATEGORIES, SEED_QUESTIONS, API_BASE } from '../lib/config';
import CorpusCount from '../components/CorpusCount.tsx';
import { CORPUS_SECTIONS } from '../lib/config';
export const prerender = true;

// Near-zero chrome, content forward, dense enough to scan in one pass — the
// browsable index reads as a board of what the corpus actually covers, not as
// a page of navigation.
type Q = { slug: string; question: string; category: string };
let live: Record<string, Q[]> = {};
try {
  const res = await fetch(`${API_BASE}/api/categories`, { signal: AbortSignal.timeout(5000) });
  if (res.ok) {
    const d = await res.json() as { categories: Array<{ id: string; questions: Q[] }> };
    live = Object.fromEntries(d.categories.map((c) => [c.id, c.questions || []]));
  }
} catch { /* seeds carry the page when the API is unreachable at build time */ }

/** Real page titles, so a source card names the page instead of showing a
    photograph of it. A screenshot of a text page is illegible at tile size. */
const SOURCE_TITLE: Record<string, string> = {
  drivetrains: 'Holonomic Drivetrains',
  odometry:    'Dead Wheels',
  intakes:     'Types of Intakes',
  electronics: 'Choosing a Servo',
  programming: 'Control Loops',
  rules:       'Types of Awards',
  build:       'Rigging',
};

const SOURCE_PAGE: Record<string, string> = {
  drivetrains: 'common-mechanisms/drivetrains/holonomic',
  odometry:    'common-mechanisms/dead-wheels',
  intakes:     'common-mechanisms/active-intake/types-of-intakes',
  electronics: 'power-and-electronics/servo-guide/choosing-servo',
  programming: 'software/concepts/control-loops',
  rules:       'awards/award-types',
  build:       'common-mechanisms/linear-motion-guide/rigging',
};

// Interleave art tiles, question tiles and source-screenshot tiles so the grid
// reads as a mosaic rather than as eight identical rows.
type Tile =
  | { kind: 'art'; cat: typeof CATEGORIES[number]; count: number }
  | { kind: 'q'; question: string; href: string; cat: string }
  | { kind: 'shot'; cat: string; label: string; url: string };

const tiles: Tile[] = [];
for (const cat of CATEGORIES) {
  const answered = live[cat.id] || [];
  const seeds = SEED_QUESTIONS[cat.id] || [];
  tiles.push({ kind: 'art', cat, count: answered.length || seeds.length });

  const qs: Tile[] = answered.length
    ? answered.slice(0, 3).map((q) => ({ kind: 'q' as const, question: q.question, href: `/q/${q.slug}`, cat: cat.id }))
    : seeds.slice(0, 3).map((q) => ({ kind: 'q' as const, question: q, href: `/ask?q=${encodeURIComponent(q)}`, cat: cat.id }));
  tiles.push(...qs);

  if (SOURCE_PAGE[cat.id]) {
    tiles.push({
      kind: 'shot', cat: cat.id, label: cat.label,
      url: `https://gm0.org/en/latest/docs/${SOURCE_PAGE[cat.id]}.html`,
    });
  }
}
---
<Base
  title="Browse the FTC documentation index — Sharp AI"
  description="Every part of the FIRST Tech Challenge documentation Sharp AI has indexed, by robot system: drivetrains, odometry, intakes, electronics, programming, rules and build."
>
  <section class="bindex">
    <header class="bindex__head">
      <p class="eyebrow">Index</p>
      <h1>Everything indexed, at a glance.</h1>
      <p>
        <CorpusCount client:visible n={CORPUS_SECTIONS} /> documentation sections from
        <a href="https://gm0.org" rel="noopener">Game Manual 0</a> and the official
        <a href="https://ftc-docs.firstinspires.org" rel="noopener">FTC Docs</a>,
        grouped by the part of the robot they touch. Pick a category tile to narrow
        the grid; the screenshots link to the source page they came from.
      </p>
    </header>

    <div class="mosaic__find">
      <label class="sr-only" for="mosaic-find">Filter the index</label>
      <svg width="15" height="15" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <input id="mosaic-find" type="search" data-find placeholder="Filter these questions" autocomplete="off" />
      <span data-find-count aria-live="polite"></span>
    </div>

    <p class="mosaic__none" data-none hidden>
      Nothing here matches that. <button type="button" data-find-ask>Ask it instead</button>
    </p>

    <p class="mosaic__filter" data-filter-bar hidden>
      Showing <strong data-filter-name></strong>
      <button type="button" data-filter-clear>Show everything</button>
    </p>

    <div class="mosaic">
      {tiles.map((t) => t.kind === 'art' ? (
        <button type="button" class="tile tile--art" data-filter={t.cat.id} data-cat={t.cat.id}
          aria-pressed="false" aria-label={`Show only ${t.cat.label}`}>
          <video
            class="tile__vid"
            poster={`/art/vid/cat-${t.cat.id}.webp?v=9cc56c63`}
            muted loop playsinline preload="none"
            width="756" height="540" aria-hidden="true"
          >
            <source src={`/art/vid/cat-${t.cat.id}.mp4?v=9cc56c63`} type="video/mp4" />
          </video>
          <div class="tile__over">
            <h2>{t.cat.label}</h2>
            <p>{t.cat.blurb}</p>
          </div>
          <span class="tile__n">{t.count}</span>
        </button>
      ) : t.kind === 'shot' ? (
        <a class="tile tile--src" href={t.url} target="_blank" rel="noopener noreferrer" data-cat={t.cat}>
          <span class="eyebrow">Source</span>
          <p class="tile__title">{SOURCE_TITLE[t.cat] ?? t.label}</p>
          <span class="tile__from">
            gm0.org
            <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true">
              <path d="M2.5 8.5 8.5 2.5M4 2.5h4.5V7" fill="none" stroke="currentColor"
                stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ) : (
        <a class="tile tile--q" href={t.href} data-cat={t.cat}>
          <p>{t.question}</p>
          <span class="tile__cat">{t.cat}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .bindex { padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) 3rem; max-width: 96rem; margin-inline: auto; }
  .bindex__head { max-width: 46rem; margin-bottom: 2.4rem; }
  .bindex__head h1 { margin: 0.7rem 0 0.9rem; max-width: 16ch; }
  .bindex__head p { font-size: 0.92rem; color: var(--ink-3); margin: 0; }
  .bindex__head a { color: var(--accent); border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }

  .tile--art {
    appearance: none; font: inherit; text-align: left; cursor: pointer;
    color: inherit; border: 0;
    perspective: 900px;
  }
  .tile__over h2 { color: var(--ink); }
  .tile.is-filtered { display: none; }
  .tile--art[aria-pressed='true'] { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mosaic__find {
    display: flex; align-items: center; gap: 0.6rem;
    max-width: 26rem; margin: 0 0 1rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--rule); border-radius: var(--r-pill);
    background: var(--paper-raised); color: var(--ink-3);
  }
  .mosaic__find:focus-within { border-color: var(--accent); }
  .mosaic__find input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
    font-family: var(--type-sans); font-size: 0.88rem; color: var(--ink);
  }
  .mosaic__find input::placeholder { color: var(--ink-3); }
  .mosaic__find input::-webkit-search-cancel-button { filter: invert(0.6); }
  .mosaic__find span {
    font-family: var(--type-mono); font-size: 0.7rem; color: var(--ink-4); white-space: nowrap;
  }
  .mosaic__none[hidden] { display: none; }
  .mosaic__none {
    margin: 0 0 1.2rem; font-size: 0.9rem; color: var(--ink-2);
  }
  .mosaic__none button {
    border: 1px solid var(--rule); background: transparent; color: var(--accent);
    border-radius: var(--r-pill); padding: 0.2rem 0.8rem; font-size: 0.85rem;
    cursor: pointer; margin-left: 0.4rem;
  }
  .mosaic__none button:hover { border-color: var(--accent); }
  .mosaic__filter[hidden] { display: none; }
  .mosaic__filter {
    display: flex; align-items: center; gap: 0.7rem;
    margin: 0 0 1.2rem; font-size: 0.88rem; color: var(--ink-3);
  }
  .mosaic__filter strong { color: var(--ink); font-weight: 500; }
  .mosaic__filter button {
    border: 1px solid var(--rule); background: transparent; color: var(--ink-2);
    border-radius: var(--r-pill); padding: 0.2rem 0.75rem; font-size: 0.8rem; cursor: pointer;
  }
  .mosaic__filter button:hover { border-color: var(--accent); color: var(--accent); }

  .mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
    grid-auto-rows: 11.5rem;
    gap: 0.6rem;
  }

  .tile {
    position: relative;
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
    display: flex;
    transition: background 0.25s var(--ease);
  }
  .tile img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s var(--ease), opacity 0.3s var(--ease);
  }
  .tile:hover img { transform: scale(1.035); }

  /* Art tiles carry the weight: two columns wide, two rows tall. */
  .tile--art { grid-column: span 2; grid-row: span 2; }
  /* The generated art is line work on its own cream paper, a shade off ours.
     Multiply drops its background out so the drawing sits on the page's paper
     instead of on a slightly wrong rectangle. */
  .tile__vid {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    display: block; background: transparent;
  }
  .tile__over {
    position: absolute; inset: auto 0 0 0;
    padding: 1rem 1.1rem;
    background: linear-gradient(transparent, var(--paper-raised) 55%);
  }
  .tile__over h2 { font-size: 1.32rem; }
  .tile__over p { margin: 0.2rem 0 0; font-size: 0.78rem; color: var(--ink-3); line-height: 1.45; max-width: 30ch; }
  .tile__n {
    position: absolute; top: 0.7rem; right: 0.85rem;
    font-family: var(--type-mono); font-size: 0.66rem; color: var(--ink-4);
  }

  /* Source cards name the page instead of photographing it. A screenshot of a
     text page is illegible at tile size and its admonition colours fight the
     palette, which is why these replaced the screenshot tiles. */
  .tile--src {
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem 1.1rem 0.9rem;
    background: var(--paper-sunk);
    border-color: var(--rule-strong);
  }
  .tile--src:hover { background: var(--accent-wash); border-color: var(--accent); }
  .tile__title {
    font-family: var(--type-serif);
    font-size: 1.16rem;
    line-height: 1.22;
    letter-spacing: -0.014em;
    margin: 0.45rem 0 0;
    text-wrap: pretty;
    color: var(--ink);
  }
  .tile__from {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    margin-top: auto;
    padding-top: 0.7rem;
    font-family: var(--type-mono);
    font-size: 0.68rem;
    color: var(--ink-3);
  }
  .tile--src:hover .tile__from { color: var(--accent); }

  .tile--q {
    flex-direction: column;
    justify-content: space-between;
    padding: 0.95rem 1rem 0.8rem;
    background: var(--paper-raised);
  }
  .tile--q:hover { border-color: var(--accent); background: var(--paper-sunk); }
  .tile--q p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.42;
    color: var(--ink);
    text-wrap: pretty;
    transition: color 0.16s var(--ease);
  }
  .tile--q:hover p { color: var(--ink); }
  .tile__cat {
    margin-top: auto;
    padding-top: 0.6rem;
    font-family: var(--type-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  @media (max-width: 44rem) {
    .mosaic { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 9.5rem; }
    .tile--art { grid-column: span 2; grid-row: span 2; }
    .tile__over h2 { font-size: 1.1rem; }
  }
</style>

<script>
  // The drawing plays as a short silent loop while the pointer is on its tile.
  // Nothing is fetched until then: the poster is the still, and preload is none.
  const arts = document.querySelectorAll('.tile--art');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const tile of arts) {
    const v = tile.querySelector('video');
    if (!v || reduced) continue;

    const play = () => { v.play().catch(() => {}); };
    // load() restores the poster frame; pause alone would freeze on whatever
    // frame the clip happened to reach.
    const stop = () => { v.pause(); v.load(); };

    tile.addEventListener('pointerenter', play);
    tile.addEventListener('pointerleave', stop);
    // Keyboard users get the same preview when the tile takes focus.
    tile.addEventListener('focus', play);
    tile.addEventListener('blur', stop);
  }
</script>

<script>
  // Tiles settle in on load, in reading order.
  import { animate, stagger, utils } from 'animejs';

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const tiles = document.querySelectorAll('.tile');
    utils.set(tiles, { opacity: 0 });
    animate(tiles, {
      opacity: [0, 1],
      y: [26, 0],
      scale: [0.97, 1],
      // grid stagger, so the wave runs from the top-left corner outward rather
      // than strictly one row at a time
      delay: stagger(34, { grid: [4, Math.ceil(tiles.length / 4)], from: 'first' }),
      duration: 760,
      ease: 'out(3)',
    });
  }
</script>

<script>
  // Category tiles filter the grid. They used to link to /ask with the blurb as
  // the query, so every click asked "Tank, mecanum, X-drive, wheels and
  // gearing." as a question and stored an answer for it. Two of those had
  // already reached the live index.
  const tiles = Array.from(document.querySelectorAll('.tile'));
  const bar = document.querySelector('[data-filter-bar]');
  const name = document.querySelector('[data-filter-name]');
  const clear = document.querySelector('[data-filter-clear]');
  let active = null;

  const find = document.querySelector('[data-find]');
  const findCount = document.querySelector('[data-find-count]');
  const noneMsg = document.querySelector('[data-none]');
  const askBtn = document.querySelector('[data-find-ask]');
  let query = '';

  // Match against the tile's own words. Art tiles carry their category label
  // and blurb, so typing "intake" keeps that category's tile alongside its
  // questions rather than hiding the thing you are filtering by.
  const haystack = new WeakMap();
  for (const el of tiles) haystack.set(el, (el.textContent || '').toLowerCase());

  const apply = () => {
    let shown = 0;
    for (const el of tiles) {
      const cat = el.getAttribute('data-cat');
      const on = (!active || cat === active)
        && (!query || (haystack.get(el) || '').includes(query));
      if (on) shown += 1;
      el.classList.toggle('is-filtered', !on);
      if (el.hasAttribute('data-filter')) {
        el.setAttribute('aria-pressed', String(el.getAttribute('data-filter') === active));
      }
    }
    if (bar) bar.hidden = !active;
    if (findCount) findCount.textContent = query || active ? `${shown} of ${tiles.length}` : '';
    if (noneMsg) noneMsg.hidden = shown > 0;
    if (name && active) {
      const label = document.querySelector(`[data-filter="${active}"] h2`);
      name.textContent = label ? label.textContent : active;
    }
  };

  for (const el of document.querySelectorAll('[data-filter]')) {
    el.addEventListener('click', () => {
      active = el.getAttribute('data-filter') === active ? null : el.getAttribute('data-filter');
      apply();
      if (active) document.querySelector('.mosaic')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
  clear?.addEventListener('click', () => { active = null; apply(); });

  let debounce;
  find?.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => { query = find.value.trim().toLowerCase(); apply(); }, 90);
  });
  // Nothing in the index matches, so offer the thing that can still answer it.
  askBtn?.addEventListener('click', () => {
    const q = (find?.value || '').trim();
    if (q) location.href = `/ask?q=${encodeURIComponent(q.slice(0, 500))}`;
  });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && active) { active = null; apply(); } });
</script>
