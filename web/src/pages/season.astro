---
import Base from '../layouts/Base.astro';
import { SEASON, ANGLES, GAME_SHAPE } from '../lib/season';
import { MANUAL_CHANGES, CHANGE_COUNT } from '../lib/manualChanges';
import { API_BASE } from '../lib/config';

// Read live rather than baked in: the moment the manual is re-ingested after
// kickoff, this page stops saying the game is unpublished.
let manual: any = null;
try {
  const r = await fetch(`${API_BASE}/api/manual`);
  if (r.ok) manual = await r.json();
} catch { /* the page is still worth serving without it */ }

const published = manual?.gamePublished ?? false;
const sections = manual?.sectionCount ?? null;
---
<Base
  title={`${SEASON.game} ${SEASON.years} — Sharp AI`}
  description={`What the ${SEASON.years} FIRST Tech Challenge manual actually says about ${SEASON.game} — the game, the scoring and the robot rules, every answer cited.`}
>
  <section class="wrap prose-page">
    <p class="eyebrow">Season</p>
    <h1>{SEASON.game} is here.</h1>
    <p class="lede">
      {SEASON.years} is <strong>{SEASON.first}</strong>, and the <em>FIRST</em> Tech Challenge game
      inside it is <strong>{SEASON.game}</strong> presented by {SEASON.presentedBy}. {SEASON.theme}
    </p>
    <p>
      {GAME_SHAPE.summary} A MATCH is {GAME_SHAPE.auto} of autonomous, a {GAME_SHAPE.transition}
      transition, then {GAME_SHAPE.teleop} of driver control.
    </p>

    <div class="season__status">
      <p class={published ? 'season__flag season__flag--live' : 'season__flag'}>
        {published ? 'Game rules published' : 'Game rules not published yet'}
      </p>
      <p>
        {published
          ? 'The V1 manual is indexed, game sections and all. Every answer below is generated from it, so it reflects the published rules rather than a summary of them.'
          : 'The indexed manual does not carry the game sections yet, so nobody — including this site — can tell you how BIOBUZZ is played. Anything claiming otherwise is guessing.'}
        {sections && ` ${sections} sections are indexed today.`}
      </p>
    </div>

    <h2>Where to start</h2>
    <p>
      Kickoff answers the big question and opens a hundred smaller ones. These are the ones worth
      asking in week one — how scoring actually breaks down, what the two SCORING ELEMENTS demand
      of an intake, and what R105 now permits once the MATCH starts. Each runs through the normal
      ask flow, so the answer arrives with the manual section behind it rather than as a claim you
      have to trust.
    </p>

    <ol class="season__angles">
      {ANGLES.map((a) => (
        <li>
          <a href={`/ask?q=${encodeURIComponent(a.q)}`}>{a.q}</a>
          <p>{a.why}</p>
        </li>
      ))}
    </ol>

    <h2>What changed from DECODE</h2>
    <p>
      {CHANGE_COUNT} differences between the DECODE manual and BIOBUZZ, compiled by
      the team before kickoff from the V0 manual. The rule changes they cover are
      structural and still stand in V1; the game sections they could not see are
      answered by the questions above. Rule and page numbers are kept exactly so you can open the manual and
      check a line rather than take this on trust — this is our reading of the changes,
      not a <em>FIRST</em> publication, and where the two disagree the manual is right.
    </p>

    {(['major', 'robot', 'minor'] as const).map((group) => (
      <section class="changes">
        <h3>
          {group === 'major' ? 'Major changes' : group === 'robot' ? 'Robot changes' : 'Minor changes'}
          <span>{MANUAL_CHANGES[group].length}</span>
        </h3>
        <ul>
          {MANUAL_CHANGES[group].map((c) => (
            <li>
              <p class="changes__head"><strong>{c.title}</strong> <code>{c.ref}</code></p>
              {c.points.length > 0 && (
                <ul class="changes__points">{c.points.map((t) => <li>{t}</li>)}</ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="season__note">
      Each question runs through the normal ask flow, so every claim comes back with the manual
      section behind it. This page deliberately contains no analysis of its own: a confident
      unsourced take on a four-day-old game is exactly the thing this site exists not to produce.
    </p>
  </section>
</Base>

<style>
  .season__status {
    border: 1px solid var(--rule); border-radius: var(--r-md);
    padding: 0.9rem 1.1rem; margin: 1.6rem 0 2rem;
  }
  .season__status p { margin: 0; font-size: 0.9rem; color: var(--ink-2); }
  .season__flag {
    font-family: var(--type-mono); font-size: 0.72rem; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--warn); margin-bottom: 0.4rem !important;
  }
  .season__flag--live { color: var(--accent); }

  .season__angles { margin: 1.4rem 0 0; padding-left: 1.1rem; display: grid; gap: 1.1rem; }
  .season__angles li::marker { color: var(--ink-3); font-family: var(--type-mono); font-size: 0.8rem; }
  .season__angles a { font-size: 1rem; color: var(--ink); border-bottom: 1px solid var(--rule-strong); }
  .season__angles a:hover { color: var(--accent); border-color: var(--accent); }
  .season__angles p { margin: 0.3rem 0 0; font-size: 0.86rem; color: var(--ink-3); max-width: 62ch; }

  .changes { margin-top: 1.8rem; }
  .changes h3 {
    display: flex; align-items: baseline; gap: 0.55rem;
    font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3); padding-bottom: 0.45rem; margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .changes h3 span {
    font-family: var(--type-mono); font-size: 0.7rem; letter-spacing: 0;
    color: var(--ink-4); border: 1px solid var(--rule-strong);
    border-radius: 999px; padding: 0 0.4rem;
  }
  .changes > ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .changes__head { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .changes__head strong { font-weight: 500; }
  .changes__head code {
    font-family: var(--type-mono); font-size: 0.72rem; color: var(--ink-3);
    border: 1px solid var(--rule); border-radius: 4px; padding: 0 0.32rem;
    white-space: nowrap;
  }
  .changes__points { margin: 0.35rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.3rem; }
  .changes__points li { font-size: 0.87rem; color: var(--ink-2); line-height: 1.55; }

  .season__note { margin-top: 2rem; font-size: 0.84rem; color: var(--ink-3); max-width: 66ch; }
</style>
