---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.tsx';
export const prerender = true;
---
<Base title="Not found — Sharp AI" description="That page does not exist." noindex>
  <section class="wrap" style="padding:clamp(4rem,10vw,8rem) 0">
    <p class="eyebrow">404</p>
    <h1 style="margin:0.7rem 0 1rem;max-width:14ch">That answer isn’t here.</h1>
    <p class="serif-lede" style="max-width:38ch;margin-bottom:2.2rem">
      The link may be old, or the answer was never written. Ask the question
      directly and Sharp AI will look it up.
    </p>
    <div style="max-width:42rem"><SearchBox client:load autofocus /></div>
  </section>
</Base>
