---
import Base from '../../layouts/Base.astro';
import ChatThread from '../../components/ChatThread.tsx';
import { API_BASE } from '../../lib/config';

// Server-rendered so Google indexes the answer text itself, not an empty shell.
// Every other page on the site stays static.
export const prerender = false;

const { slug } = Astro.params;

let answer: any = null;
try {
  const res = await fetch(`${API_BASE}/api/answer/${encodeURIComponent(slug!)}`, {
    signal: AbortSignal.timeout(6000),
  });
  if (res.ok) answer = await res.json();
} catch { /* fall through to 404 */ }

if (!answer) return Astro.rewrite('/404');

const plain = String(answer.answerMd)
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/\(https?:\/\/[^)]+\)/g, '')
  .replace(/[#*`>_\[\]]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const description = plain.length > 158 ? `${plain.slice(0, 155)}…` : plain;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'QAPage',
  mainEntity: {
    '@type': 'Question',
    name: answer.question,
    text: answer.question,
    answerCount: 1,
    dateCreated: answer.createdAt,
    acceptedAnswer: {
      '@type': 'Answer',
      text: plain,
      dateCreated: answer.createdAt,
      url: `https://sharp-ai-8a1.pages.dev/q/${answer.slug}`,
      citation: (answer.citations || []).map((c: any) => c.url),
    },
  },
  isPartOf: { '@type': 'WebSite', name: 'Sharp AI', url: 'https://sharp-ai-8a1.pages.dev' },
};
---
<Base
  title={`${answer.question} — Sharp AI`}
  description={description}
  canonical={`https://sharp-ai-8a1.pages.dev/q/${answer.slug}`}
  jsonLd={jsonLd}
  bare
>
  <ChatThread
    client:load
    seed={{
      question: answer.question,
      answerMd: answer.answerMd,
      citations: answer.citations,
      excerpts: answer.excerpts,
      slug: answer.slug,
    }}
  />
</Base>
