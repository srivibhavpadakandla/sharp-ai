---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.tsx';
import ScatterField from '../components/ScatterField.tsx';
import { CATEGORIES, SEED_QUESTIONS, API_BASE, SITE_TAGLINE } from '../lib/config';

// Popular questions come from the answers table when the site has traffic;
// until then the seeded list keeps the index dense and browsable.
type Q = { slug: string; question: string; category: string };
let live: Record<string, Q[]> = {};
try {
  const res = await fetch(`${API_BASE}/api/categories`, { signal: AbortSignal.timeout(4000) });
  if (res.ok) {
    const data = await res.json() as { categories: Array<{ id: string; questions: Q[] }> };
    live = Object.fromEntries(data.categories.map((c) => [c.id, c.questions || []]));
  }
} catch { /* build offline: fall back to seeds */ }

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sharp AI',
  description: SITE_TAGLINE,
  url: 'https://sharp-ai-8a1.pages.dev',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://sharp-ai-8a1.pages.dev/ask?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---
<Base
  title="Sharp AI — FTC documentation, answered"
  description="Ask a question about building, wiring or programming a FIRST Tech Challenge robot and get an answer drawn from indexed official documentation, with the source section shown next to it."
  jsonLd={jsonLd}
>
  <section class="hero">
    <ScatterField client:idle />
    <div class="wrap">
      <p class="hero__mark rise d1">Sharp AI</p>
      <h1 class="hero__title rise d2">
        The FTC documentation,<br /><em>searchable.</em>
      </h1>
      <p class="hero__lede rise d3">
        Game Manual 0, the official FTC Docs, the SDK reference, the Competition
        Manual and Pedro Pathing — indexed section by section.
      </p>
      <div class="hero__actions rise d4">
        <a class="btn btn--primary" href="/chat">Ask a question</a>
        <a class="btn" href="/browse">Browse the index</a>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section id="browse" class="browse">
    <div class="wrap">
      <div class="browse__head">
        <h2>Browse by system</h2>
        <p>Questions already answered, grouped by the part of the robot they touch.</p>
      </div>

      <div class="grid">
        {CATEGORIES.map((cat) => {
          const answered = live[cat.id] || [];
          const seeds = SEED_QUESTIONS[cat.id] || [];
          return (
            <article class="cell">
              <header class="cell__head">
                <h3>{cat.label}</h3>
                <span class="cell__n">{answered.length || seeds.length}</span>
              </header>
              <p class="cell__blurb">{cat.blurb}</p>
              <ul class="cell__list">
                {answered.slice(0, 5).map((q) => (
                  <li><a href={`/q/${q.slug}`}>{q.question}</a></li>
                ))}
                {answered.length === 0 && seeds.slice(0, 5).map((q) => (
                  <li><a href={`/ask?q=${encodeURIComponent(q)}`}>{q}</a></li>
                ))}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="how">
    <div class="wrap">
      <div class="how__grid">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 class="how__title">Retrieval first, language second.</h2>
        </div>
        <ol class="how__steps">
          <li>
            <strong>Search twice.</strong> Your question runs against a keyword
            index and a semantic index at the same time, and the two result
            lists are merged by rank.
          </li>
          <li>
            <strong>Refuse early.</strong> If nothing in the documentation is a
            real match, Sharp AI says so and stops — before a language model is
            ever called.
          </li>
          <li>
            <strong>Answer from the page.</strong> The model may only use the
            retrieved sections, must cite each claim, and is instructed never to
            invent a part number, gear ratio or rule number.
          </li>
          <li>
            <strong>Keep the receipts.</strong> Every answer gets a permanent
            link, and the sections it used stay next to it.
          </li>
        </ol>
      </div>
    </div>
  </section>
</Base>
