---
import '../styles/global.css';
import { SITE_NAME } from '../lib/config';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { title, description, canonical, noindex = false, jsonLd } = Astro.props;
const url = canonical || new URL(Astro.url.pathname, Astro.site ?? 'https://sharp-ai-8a1.pages.dev').href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <header class="site-head">
    <div class="wrap">
      <a href="/" class="wordmark">Sharp<em>AI</em></a>
      <nav>
        <a href="/browse">Browse</a>
        <a href="/error">Paste an error</a>
        <a href="/about">About</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="cols">
        <div>
          <p style="margin-bottom:0.6em">
            Sharp AI answers from indexed FIRST Tech Challenge documentation.
            Documentation text is quoted from
            <a href="https://gm0.org" rel="noopener">Game Manual 0</a>,
            used under
            <a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="license noopener">CC BY-NC 4.0</a>.
          </p>
          <p style="margin:0;color:var(--ink-3)">
            Because Game Manual 0 is licensed non-commercially, this site carries
            no advertising, no paid tier and no sponsorship. It never will.
          </p>
        </div>
        <div>
          <p class="eyebrow" style="margin-bottom:0.7em">Indexed sources</p>
          <p style="margin:0">
            <a href="https://gm0.org" rel="noopener">Game Manual 0</a><br />
            <span style="color:var(--ink-4)">ftc-docs, REV, CTRL ALT FTC, SDK javadocs — planned</span>
          </p>
        </div>
      </div>
      <p class="disclaimer">
        Sharp AI is an unofficial, independent project. It is not affiliated with
        or endorsed by <em>FIRST</em>. Answers are generated by a language model
        from retrieved documentation and <strong>can be wrong</strong> — always
        verify against the linked source, and against the official Game Manual
        for anything rules-related before you act on it.
      </p>
    </div>
  </footer>
</body>
</html>
